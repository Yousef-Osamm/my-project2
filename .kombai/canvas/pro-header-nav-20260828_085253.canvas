    "var_50ba87d212d6": {
      "type": "variant",
      "label": "الحافة الموجّهة — هيدر مرجاني قطري",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alexandria:wght@600&family=IBM+Plex+Sans+Arabic:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ink: #102126;\n    --surface: #f2f6f5;\n    --surface-strong: #ffffff;\n    --mist: #bfd7d3;\n    --coral: #f05a43;\n    --coral-pressed: #dc4935;\n    --line: #d2dfdc;\n    --muted: #5e7474;\n    --focus: #f05a43;\n    --serif-brand: 'Alexandria', sans-serif;\n    --ui-font: 'IBM Plex Sans Arabic', sans-serif;\n  }\n\n  .preview-surface {\n    min-height: 440px;\n    padding: 30px 20px 110px;\n    overflow-x: hidden;\n    background: #dce8e4;\n    color: var(--ink);\n    font-family: var(--ui-font);\n    direction: rtl;\n  }\n\n  .site-header {\n    position: relative;\n    z-index: 20;\n    width: min(100%, 1240px);\n    margin: 0 auto;\n    background: var(--surface);\n    border-bottom: 1px solid var(--ink);\n  }\n\n  .header-inner {\n    display: flex;\n    min-height: 78px;\n    align-items: stretch;\n    direction: rtl;\n  }\n\n  .brand-lockup {\n    display: inline-flex;\n    width: 190px;\n    flex: 0 0 190px;\n    align-items: center;\n    gap: 11px;\n    padding: 0 22px;\n    color: var(--ink);\n    text-decoration: none;\n    border-left: 1px solid var(--line);\n  }\n\n  .brand-lockup:focus-visible,\n  .nav-link:focus-visible,\n  .nav-trigger:focus-visible,\n  .login-link:focus-visible,\n  .primary-action:focus-visible,\n  .mobile-toggle:focus-visible,\n  .mobile-summary:focus-visible,\n  .mobile-link:focus-visible {\n    outline: 2px solid var(--focus);\n    outline-offset: 3px;\n  }\n\n  .brand-mark {\n    display: block;\n    width: 34px;\n    height: 34px;\n    flex: 0 0 34px;\n  }\n\n  .brand-name {\n    font-family: var(--serif-brand);\n    font-size: 20px;\n    font-weight: 600;\n    letter-spacing: -0.04em;\n    line-height: 1;\n  }\n\n  .desktop-nav {\n    position: relative;\n    display: flex;\n    min-width: 0;\n    flex: 1 1 auto;\n    align-items: stretch;\n    padding: 0 22px;\n  }\n\n  .nav-list {\n    display: flex;\n    min-width: 0;\n    align-items: stretch;\n    gap: 8px;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .nav-list > li {\n    display: flex;\n    align-items: stretch;\n  }\n\n  .nav-link,\n  .nav-trigger {\n    position: relative;\n    display: inline-flex;\n    min-height: 78px;\n    align-items: center;\n    gap: 7px;\n    padding: 0 14px;\n    color: var(--ink);\n    font-family: var(--ui-font);\n    font-size: 15px;\n    font-weight: 500;\n    line-height: 1;\n    text-decoration: none;\n    white-space: nowrap;\n    border: 0;\n    background: transparent;\n    cursor: pointer;\n  }\n\n  .nav-link::after,\n  .nav-trigger[aria-current='page']::after {\n    position: absolute;\n    right: 50%;\n    bottom: -1px;\n    width: 0;\n    height: 0;\n    content: '';\n    transform: translateX(50%);\n    border-right: 6px solid transparent;\n    border-bottom: 7px solid var(--coral);\n    border-left: 6px solid transparent;\n    opacity: 0;\n  }\n\n  .nav-trigger[aria-current='page']::after {\n    opacity: 1;\n  }\n\n  .nav-link:hover,\n  .nav-trigger:hover {\n    color: var(--coral);\n  }\n\n  .nav-link:hover::after {\n    opacity: 1;\n  }\n\n  .nav-dropdown {\n    position: relative;\n    display: flex;\n    align-items: stretch;\n  }\n\n  .nav-dropdown > summary {\n    list-style: none;\n  }\n\n  .nav-dropdown > summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .nav-trigger .chevron-icon {\n    display: inline-flex;\n    width: 15px;\n    height: 15px;\n    align-items: center;\n    justify-content: center;\n    color: currentColor;\n    font-size: 15px;\n    line-height: 1;\n    transition: transform 140ms ease;\n  }\n\n  .nav-dropdown[open] .chevron-icon {\n    transform: rotate(180deg);\n  }\n\n  .dropdown-panel {\n    position: absolute;\n    top: calc(100% + 1px);\n    right: 0;\n    width: 360px;\n    padding: 8px 0;\n    background: var(--surface-strong);\n    border: 1px solid var(--ink);\n    border-top: 3px solid var(--coral);\n    clip-path: polygon(0 0, 100% 0, 100% 100%, 14px 100%, 0 calc(100% - 14px));\n  }\n\n  .dropdown-kicker {\n    display: block;\n    padding: 12px 18px 8px;\n    color: var(--muted);\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: 0.08em;\n  }\n\n  .dropdown-link {\n    display: flex;\n    min-height: 48px;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 18px;\n    color: var(--ink);\n    font-size: 15px;\n    font-weight: 400;\n    text-decoration: none;\n    border-top: 1px solid var(--line);\n  }\n\n  .dropdown-link:hover,\n  .dropdown-link:focus-visible {\n    color: var(--coral);\n    background: var(--mist);\n  }\n\n  .dropdown-link .row-arrow {\n    display: inline-flex;\n    width: 16px;\n    height: 16px;\n    align-items: center;\n    justify-content: center;\n    color: currentColor;\n    font-size: 15px;\n  }\n\n  .header-actions {\n    display: flex;\n    width: 300px;\n    flex: 0 0 300px;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 22px;\n    padding: 0 20px 0 0;\n    border-right: 1px solid var(--line);\n  }\n\n  .login-link {\n    color: var(--ink);\n    font-size: 14px;\n    font-weight: 500;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  .login-link:hover {\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 5px;\n  }\n\n  .primary-action {\n    display: inline-flex;\n    min-width: 158px;\n    height: 46px;\n    align-items: center;\n    justify-content: center;\n    padding: 0 20px;\n    color: var(--ink);\n    background: var(--coral);\n    border: 0;\n    font-family: var(--ui-font);\n    font-size: 14px;\n    font-weight: 500;\n    text-decoration: none;\n    white-space: nowrap;\n    clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%, 0 12px);\n    cursor: pointer;\n  }\n\n  .primary-action:hover {\n    background: var(--coral-pressed);\n  }\n\n  .primary-action:active {\n    background: #c94130;\n  }\n\n  .mobile-toggle {\n    display: none;\n    width: 44px;\n    height: 44px;\n    align-items: center;\n    justify-content: center;\n    margin: auto 10px auto 0;\n    padding: 0;\n    color: var(--ink);\n    background: transparent;\n    border: 1px solid var(--ink);\n    cursor: pointer;\n  }\n\n  .menu-icon,\n  .close-icon {\n    display: inline-flex;\n    width: 20px;\n    height: 20px;\n    align-items: center;\n    justify-content: center;\n    color: currentColor;\n    font-size: 20px;\n    line-height: 1;\n  }\n\n  .close-icon {\n    display: none;\n  }\n\n  .mobile-toggle.is-open .menu-icon {\n    display: none;\n  }\n\n  .mobile-toggle.is-open .close-icon {\n    display: inline-flex;\n  }\n\n  .mobile-panel {\n    display: none;\n    background: var(--surface);\n    border-top: 1px solid var(--ink);\n  }\n\n  .mobile-nav-list {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .mobile-row,\n  .mobile-summary,\n  .mobile-link {\n    width: 100%;\n    min-height: 54px;\n    box-sizing: border-box;\n    color: var(--ink);\n    font-family: var(--ui-font);\n    font-size: 16px;\n    font-weight: 500;\n    text-decoration: none;\n    border: 0;\n    border-bottom: 1px solid var(--line);\n    background: transparent;\n  }\n\n  .mobile-summary,\n  .mobile-link {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 20px;\n    cursor: pointer;\n  }\n\n  .mobile-summary {\n    list-style: none;\n  }\n\n  .mobile-summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .mobile-summary[aria-current='page'] {\n    color: var(--coral);\n  }\n\n  .mobile-summary .mobile-chevron {\n    display: inline-flex;\n    width: 18px;\n    height: 18px;\n    align-items: center;\n    justify-content: center;\n    color: currentColor;\n    font-size: 18px;\n    transition: transform 140ms ease;\n  }\n\n  .mobile-dropdown[open] .mobile-chevron {\n    transform: rotate(180deg);\n  }\n\n  .mobile-submenu {\n    padding: 0 20px 0 36px;\n    background: #e7f0ed;\n  }\n\n  .mobile-submenu .mobile-link {\n    min-height: 46px;\n    padding: 0;\n    color: var(--muted);\n    font-size: 14px;\n    font-weight: 400;\n  }\n\n  .mobile-actions {\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n    padding: 22px 20px 26px;\n  }\n\n  .mobile-actions .primary-action {\n    width: 100%;\n  }\n\n  .mobile-login {\n    align-self: center;\n    color: var(--ink);\n    font-size: 14px;\n    font-weight: 500;\n    text-decoration: none;\n  }\n\n  .mobile-login:hover {\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .quiet-space {\n    width: min(100%, 1240px);\n    height: 230px;\n    margin: 0 auto;\n    background: rgba(242, 246, 245, 0.32);\n    border-top: 1px solid rgba(16, 33, 38, 0.1);\n  }\n\n  .menu-locked {\n    overflow: hidden;\n  }\n\n  @media (max-width: 980px) {\n    .brand-lockup {\n      width: 170px;\n      flex-basis: 170px;\n      padding-inline: 16px;\n    }\n\n    .header-actions {\n      width: 260px;\n      flex-basis: 260px;\n      gap: 14px;\n      padding-right: 14px;\n    }\n\n    .primary-action {\n      min-width: 142px;\n      padding-inline: 14px;\n    }\n\n    .desktop-nav {\n      padding-inline: 10px;\n    }\n\n    .nav-link,\n    .nav-trigger {\n      padding-inline: 9px;\n      font-size: 14px;\n    }\n  }\n\n  @media (max-width: 860px) {\n    .preview-surface {\n      min-height: 520px;\n      padding: 0 0 80px;\n    }\n\n    .site-header {\n      width: 100%;\n      margin: 0;\n    }\n\n    .header-inner {\n      min-height: 62px;\n      height: 62px;\n    }\n\n    .brand-lockup {\n      width: auto;\n      flex: 1 1 auto;\n      min-width: 0;\n      padding-inline: 18px;\n      border-left: 0;\n    }\n\n    .brand-mark {\n      width: 30px;\n      height: 30px;\n      flex-basis: 30px;\n    }\n\n    .brand-name {\n      font-size: 18px;\n    }\n\n    .desktop-nav,\n    .header-actions {\n      display: none;\n    }\n\n    .mobile-toggle {\n      display: inline-flex;\n    }\n\n    .js-enabled .mobile-panel.is-open,\n    .no-js .mobile-panel {\n      display: block;\n    }\n\n    .quiet-space {\n      width: 100%;\n      height: 280px;\n      border-top: 0;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .nav-trigger .chevron-icon,\n    .mobile-summary .mobile-chevron {\n      transition: none;\n    }\n  }\n</style>\n<div class=\"preview-surface no-js\" data-kid=\"1\" data-name=\"site preview container\" dir=\"rtl\" id=\"header-preview\" lang=\"ar\">\n    <header class=\"site-header\" data-kid=\"1-1\" data-name=\"site header section\" id=\"site-header\">\n        <div class=\"header-inner\" data-kid=\"1-1-1\" data-name=\"header layout inner\">\n            <a aria-label=\"نَسَق — الصفحة الرئيسية\" class=\"brand-lockup\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#home\">\n                <svg aria-label=\"علامة نَسَق\" class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand mark icon\" role=\"img\" viewbox=\"0 0 48 48\">\n                    <path d=\"M24 3 45 41H3Z\" fill=\"#102126\">\n                    </path>\n                    <path d=\"M27 12 43 42H11Z\" fill=\"#F05A43\">\n                    </path>\n                </svg>\n                <span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    نَسَق\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"desktop-nav\" data-kid=\"1-1-1-2\" data-name=\"desktop navigation container\">\n                <ul class=\"nav-list\" data-kid=\"1-1-1-2-1\" data-name=\"desktop navigation list\">\n                    <li data-kid=\"1-1-1-2-1-1\" data-name=\"product dropdown container\">\n                        <details class=\"nav-dropdown\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"product details menu\" data-reason=\"open state toggled by script\" id=\"product-details\" open=\"\">\n                            <summary aria-controls=\"product-menu\" aria-current=\"page\" aria-expanded=\"true\" class=\"nav-trigger\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1-1-1\" data-name=\"product dropdown trigger\" data-reason=\"aria-expanded attribute updated by script\" id=\"product-trigger\">\n                                <span data-kid=\"1-1-1-2-1-1-1-1-1\" data-name=\"product label text\">\n                                    المنتج\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down chevron-icon\" data-kid=\"1-1-1-2-1-1-1-1-2\" data-name=\"dropdown chevron icon\">\n                                </i>\n                            </summary>\n                            <div aria-label=\"روابط المنتج\" class=\"dropdown-panel\" data-kid=\"1-1-1-2-1-1-1-2\" data-name=\"product dropdown panel\" id=\"product-menu\" role=\"region\">\n                                <span class=\"dropdown-kicker\" data-kid=\"1-1-1-2-1-1-1-2-1\" data-name=\"dropdown kicker label\">\n                                    مسارات المنتج\n                                </span>\n                                <a class=\"dropdown-link\" data-kid=\"1-1-1-2-1-1-1-2-2\" data-name=\"product overview link\" href=\"#product-overview\">\n                                    <span data-kid=\"1-1-1-2-1-1-1-2-2-1\" data-name=\"overview link text\">\n                                        نظرة عامة\n                                    </span>\n                                    <i aria-hidden=\"true\" class=\"ti ti-arrow-left row-arrow\" data-kid=\"1-1-1-2-1-1-1-2-2-2\" data-name=\"overview arrow icon\">\n                                    </i>\n                                </a>\n                                <a class=\"dropdown-link\" data-kid=\"1-1-1-2-1-1-1-2-3\" data-name=\"automation link\" href=\"#automation\">\n                                    <span data-kid=\"1-1-1-2-1-1-1-2-3-1\" data-name=\"automation link text\">\n                                        الأتمتة\n                                    </span>\n                                    <i aria-hidden=\"true\" class=\"ti ti-arrow-left row-arrow\" data-kid=\"1-1-1-2-1-1-1-2-3-2\" data-name=\"automation arrow icon\">\n                                    </i>\n                                </a>\n                                <a class=\"dropdown-link\" data-kid=\"1-1-1-2-1-1-1-2-4\" data-name=\"integrations link\" href=\"#integrations\">\n                                    <span data-kid=\"1-1-1-2-1-1-1-2-4-1\" data-name=\"integrations link text\">\n                                        التكاملات\n                                    </span>\n                                    <i aria-hidden=\"true\" class=\"ti ti-arrow-left row-arrow\" data-kid=\"1-1-1-2-1-1-1-2-4-2\" data-name=\"integrations arrow icon\">\n                                    </i>\n                                </a>\n                            </div>\n                        </details>\n                    </li>\n                    <li data-kid=\"1-1-1-2-1-2\" data-name=\"solutions navigation link\">\n                        <a class=\"nav-link\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"solutions link text\" href=\"#solutions\">\n                            الحلول\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-1-2-1-3\" data-name=\"pricing navigation link\">\n                        <a class=\"nav-link\" data-kid=\"1-1-1-2-1-3-1\" data-name=\"pricing link text\" href=\"#pricing\">\n                            الأسعار\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-1-2-1-4\" data-name=\"resources navigation link\">\n                        <a class=\"nav-link\" data-kid=\"1-1-1-2-1-4-1\" data-name=\"resources link text\" href=\"#resources\">\n                            الموارد\n                        </a>\n                    </li>\n                </ul>\n            </nav>\n            <div aria-label=\"إجراءات الحساب\" class=\"header-actions\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n                <a class=\"login-link\" data-kid=\"1-1-1-3-1\" data-name=\"login link\" href=\"#login\">\n                    تسجيل الدخول\n                </a>\n                <a class=\"primary-action\" data-kid=\"1-1-1-3-2\" data-name=\"primary action button\" href=\"#workspace\">\n                    أنشئ مساحة عمل\n                </a>\n            </div>\n            <button aria-controls=\"mobile-panel\" aria-expanded=\"false\" aria-label=\"فتح القائمة\" class=\"mobile-toggle\" data-dynamic=\"true\" data-kid=\"1-1-1-4\" data-name=\"mobile menu toggle button\" data-reason=\"aria-expanded and aria-label updated by script\" id=\"mobile-toggle\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-menu-2 menu-icon\" data-kid=\"1-1-1-4-1\" data-name=\"menu icon\">\n                </i>\n                <i aria-hidden=\"true\" class=\"ti ti-x close-icon\" data-kid=\"1-1-1-4-2\" data-name=\"close icon\">\n                </i>\n            </button>\n        </div>\n        <div aria-label=\"قائمة الهاتف\" class=\"mobile-panel\" data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"mobile navigation panel\" data-reason=\"is-open class toggled by script\" id=\"mobile-panel\">\n            <nav aria-label=\"التنقل الرئيسي على الهاتف\" data-kid=\"1-1-2-1\" data-name=\"mobile navigation container\">\n                <ul class=\"mobile-nav-list\" data-kid=\"1-1-2-1-1\" data-name=\"mobile navigation list\">\n                    <li data-kid=\"1-1-2-1-1-1\" data-name=\"mobile product dropdown container\">\n                        <details class=\"mobile-dropdown\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"mobile product details menu\" data-reason=\"open state toggled by script\" id=\"mobile-product-details\">\n                            <summary aria-controls=\"mobile-product-menu\" aria-current=\"page\" aria-expanded=\"false\" class=\"mobile-summary\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1-1-1\" data-name=\"mobile product dropdown trigger\" data-reason=\"aria-expanded attribute updated by script\" id=\"mobile-product-trigger\">\n                                <span data-kid=\"1-1-2-1-1-1-1-1-1\" data-name=\"mobile product label text\">\n                                    المنتج\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down mobile-chevron\" data-kid=\"1-1-2-1-1-1-1-1-2\" data-name=\"mobile product chevron icon\">\n                                </i>\n                            </summary>\n                            <div class=\"mobile-submenu\" data-kid=\"1-1-2-1-1-1-1-2\" data-name=\"mobile product submenu container\" id=\"mobile-product-menu\">\n                                <a class=\"mobile-link\" data-kid=\"1-1-2-1-1-1-1-2-1\" data-name=\"mobile product overview link\" href=\"#product-overview\">\n                                    نظرة عامة\n                                </a>\n                                <a class=\"mobile-link\" data-kid=\"1-1-2-1-1-1-1-2-2\" data-name=\"mobile automation link\" href=\"#automation\">\n                                    الأتمتة\n                                </a>\n                                <a class=\"mobile-link\" data-kid=\"1-1-2-1-1-1-1-2-3\" data-name=\"mobile integrations link\" href=\"#integrations\">\n                                    التكاملات\n                                </a>\n                            </div>\n                        </details>\n                    </li>\n                    <li data-kid=\"1-1-2-1-1-2\" data-name=\"mobile solutions link\">\n                        <a class=\"mobile-link\" data-kid=\"1-1-2-1-1-2-1\" href=\"#solutions\">\n                            الحلول\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-2-1-1-3\" data-name=\"mobile pricing link\">\n                        <a class=\"mobile-link\" data-kid=\"1-1-2-1-1-3-1\" href=\"#pricing\">\n                            الأسعار\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-2-1-1-4\" data-name=\"mobile resources link\">\n                        <a class=\"mobile-link\" data-kid=\"1-1-2-1-1-4-1\" href=\"#resources\">\n                            الموارد\n                        </a>\n                    </li>\n                </ul>\n            </nav>\n            <div class=\"mobile-actions\" data-kid=\"1-1-2-2\" data-name=\"mobile actions container\">\n                <a class=\"primary-action\" data-kid=\"1-1-2-2-1\" data-name=\"mobile primary action button\" href=\"#workspace\">\n                    أنشئ مساحة عمل\n                </a>\n                <a class=\"mobile-login\" data-kid=\"1-1-2-2-2\" data-name=\"mobile login link\" href=\"#login\">\n                    تسجيل الدخول\n                </a>\n            </div>\n        </div>\n    </header>\n    <div aria-hidden=\"true\" class=\"quiet-space\" data-kid=\"1-2\" data-name=\"quiet decorative space\">\n    </div>\n</div>\n<script>\n    (() => {\n    const preview = document.getElementById('header-preview');\n    const header = document.getElementById('site-header');\n    const productDetails = document.getElementById('product-details');\n    const productTrigger = document.getElementById('product-trigger');\n    const mobileProductDetails = document.getElementById('mobile-product-details');\n    const mobileProductTrigger = document.getElementById('mobile-product-trigger');\n    const mobileToggle = document.getElementById('mobile-toggle');\n    const mobilePanel = document.getElementById('mobile-panel');\n\n    preview.classList.remove('no-js');\n    preview.classList.add('js-enabled');\n\n    const setProductState = (isOpen) => {\n      productDetails.open = isOpen;\n      productTrigger.setAttribute('aria-expanded', String(isOpen));\n    };\n\n    const setMobileProductState = (isOpen) => {\n      mobileProductDetails.open = isOpen;\n      mobileProductTrigger.setAttribute('aria-expanded', String(isOpen));\n    };\n\n    const setMobileState = (isOpen) => {\n      mobileToggle.classList.toggle('is-open', isOpen);\n      mobileToggle.setAttribute('aria-expanded', String(isOpen));\n      mobileToggle.setAttribute('aria-label', isOpen ? 'إغلاق القائمة' : 'فتح القائمة');\n      mobilePanel.classList.toggle('is-open', isOpen);\n      document.body.classList.toggle('menu-locked', isOpen);\n      if (!isOpen) setMobileProductState(false);\n    };\n\n    productDetails.addEventListener('toggle', () => {\n      productTrigger.setAttribute('aria-expanded', String(productDetails.open));\n    });\n\n    mobileProductDetails.addEventListener('toggle', () => {\n      mobileProductTrigger.setAttribute('aria-expanded', String(mobileProductDetails.open));\n    });\n\n    mobileToggle.addEventListener('click', () => {\n      setMobileState(!mobileToggle.classList.contains('is-open'));\n    });\n\n    mobilePanel.querySelectorAll('a').forEach((link) => {\n      link.addEventListener('click', () => setMobileState(false));\n    });\n\n    document.addEventListener('click', (event) => {\n      if (!header.contains(event.target)) {\n        setProductState(false);\n        setMobileState(false);\n      }\n    });\n\n    document.addEventListener('keydown', (event) => {\n      if (event.key !== 'Escape') return;\n      const mobileWasOpen = mobileToggle.classList.contains('is-open');\n      setProductState(false);\n      setMobileState(false);\n      if (mobileWasOpen) mobileToggle.focus();\n      else productTrigger.focus();\n    });\n  })();\n</script>\n",
