    },
    "var_33edee195c16": {
      "type": "variant",
      "label": "فهرس الاتجاهات — هيدر مرقّم",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Readex+Pro:wght@400;500;600&family=Reem+Kufi:wght@600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ceramic: #F0F3EF;\n    --ceramic-context: #E7EDE8;\n    --indigo: #1A2B57;\n    --crimson: #C83B31;\n    --ink: #171D1C;\n    --rule: #C6D0C7;\n    --muted: #66736C;\n  }\n\n  .header-preview,\n  .header-preview * {\n    box-sizing: border-box;\n  }\n\n  .header-preview {\n    min-height: 460px;\n    width: 100%;\n    margin: 0;\n    padding: 64px 48px 96px;\n    background: var(--ceramic-context);\n    color: var(--ink);\n    font-family: 'Readex Pro', sans-serif;\n    direction: rtl;\n  }\n\n  .header-preview__caption {\n    width: min(1180px, 100%);\n    margin: 0 auto 12px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: var(--muted);\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: .04em;\n    line-height: 1.4;\n  }\n\n  .header-preview__caption-rule {\n    display: inline-block;\n    width: 32px;\n    height: 1px;\n    margin-inline-start: 8px;\n    background: var(--crimson);\n    vertical-align: middle;\n  }\n\n  .site-header {\n    position: relative;\n    z-index: 20;\n    width: min(1180px, 100%);\n    margin: 0 auto;\n    min-height: 72px;\n    display: grid;\n    grid-template-columns: 250px minmax(0, 1fr) 260px;\n    align-items: stretch;\n    background: var(--ceramic);\n    border-top: 1px solid var(--rule);\n    border-inline: 1px solid var(--rule);\n    border-bottom: 3px solid var(--indigo);\n  }\n\n  .brand-lockup {\n    min-width: 0;\n    min-height: 72px;\n    padding: 0 26px;\n    display: inline-flex;\n    align-items: center;\n    gap: 11px;\n    color: var(--indigo);\n    text-decoration: none;\n    border-left: 1px solid var(--rule);\n  }\n\n  .brand-lockup:focus-visible,\n  .desktop-nav a:focus-visible,\n  .desktop-nav button:focus-visible,\n  .header-action:focus-visible,\n  .mobile-menu-toggle:focus-visible,\n  .mobile-index a:focus-visible,\n  .mobile-index button:focus-visible {\n    outline: 2px solid var(--crimson);\n    outline-offset: 3px;\n  }\n\n  .brand-lockup__mark {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    flex: 0 0 auto;\n  }\n\n  .brand-lockup__diamond {\n    width: 28px;\n    height: 28px;\n    display: block;\n    color: var(--indigo);\n  }\n\n  .brand-lockup__signature {\n    width: 3px;\n    height: 24px;\n    display: block;\n    background: var(--crimson);\n  }\n\n  .brand-lockup__name {\n    font-family: 'Reem Kufi', sans-serif;\n    font-size: 21px;\n    font-weight: 600;\n    letter-spacing: -.03em;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .desktop-nav {\n    min-width: 0;\n    min-height: 72px;\n  }\n\n  .desktop-nav__list {\n    height: 72px;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    list-style: none;\n  }\n\n  .nav-unit {\n    position: relative;\n    min-width: 0;\n    display: flex;\n    border-inline-start: 1px solid var(--rule);\n  }\n\n  .nav-unit:last-child {\n    border-inline-start: 0;\n  }\n\n  .nav-unit__link,\n  .nav-unit__trigger {\n    position: relative;\n    width: 100%;\n    min-height: 72px;\n    padding: 0 17px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    color: var(--indigo);\n    background: transparent;\n    border: 0;\n    font: inherit;\n    font-size: 14px;\n    font-weight: 500;\n    line-height: 1.25;\n    text-decoration: none;\n    cursor: pointer;\n    white-space: nowrap;\n  }\n\n  .nav-unit__link::after,\n  .nav-unit__trigger::after {\n    content: '';\n    position: absolute;\n    right: 18px;\n    bottom: 0;\n    width: 0;\n    height: 3px;\n    background: var(--crimson);\n    transition: width 150ms ease;\n  }\n\n  .nav-unit__link:hover::after,\n  .nav-unit__trigger:hover::after,\n  .nav-unit__link:focus-visible::after,\n  .nav-unit__trigger:focus-visible::after {\n    width: calc(100% - 36px);\n  }\n\n  .nav-unit--active {\n    background: var(--indigo);\n    color: var(--ceramic);\n  }\n\n  .nav-unit--active::before {\n    content: '';\n    position: absolute;\n    z-index: 2;\n    top: 0;\n    right: 0;\n    width: 0;\n    height: 0;\n    border-top: 11px solid var(--crimson);\n    border-left: 11px solid transparent;\n  }\n\n  .nav-unit--active .nav-unit__trigger {\n    color: var(--ceramic);\n  }\n\n  .nav-unit--active .nav-unit__trigger::after {\n    display: none;\n  }\n\n  .nav-unit__number {\n    direction: ltr;\n    color: currentColor;\n    font-family: 'Readex Pro', sans-serif;\n    font-size: 10px;\n    font-variant-numeric: tabular-nums;\n    font-weight: 400;\n    opacity: .62;\n    line-height: 1;\n  }\n\n  .nav-unit--active .nav-unit__number {\n    opacity: .82;\n  }\n\n  .nav-unit__chevron {\n    width: 16px;\n    height: 16px;\n    font-size: 16px;\n    line-height: 16px;\n    flex: 0 0 16px;\n    transition: transform 140ms ease;\n  }\n\n  .nav-unit__trigger[aria-expanded='true'] .nav-unit__chevron {\n    transform: rotate(-90deg);\n  }\n\n  .header-actions {\n    min-height: 72px;\n    padding: 0 17px 0 21px;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 18px;\n    border-right: 1px solid var(--rule);\n  }\n\n  .header-action {\n    color: var(--indigo);\n    font-family: 'Readex Pro', sans-serif;\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1.25;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  .header-action--secondary:hover,\n  .header-action--secondary:focus-visible {\n    text-decoration: underline;\n    text-underline-offset: 5px;\n  }\n\n  .header-action--primary {\n    min-height: 46px;\n    padding: 0 22px 0 30px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    background: var(--crimson);\n    clip-path: polygon(0 50%, 10% 0, 100% 0, 100% 100%, 10% 100%);\n    font-size: 12px;\n    font-weight: 500;\n    text-decoration: none;\n    transition: background-color 140ms ease;\n  }\n\n  .header-action--primary:hover,\n  .header-action--primary:focus-visible {\n    background: #A92F28;\n  }\n\n  .header-action--primary:active {\n    background: #922922;\n  }\n\n  @supports not (clip-path: polygon(0 50%, 10% 0, 100% 0, 100% 100%, 10% 100%)) {\n    .header-action--primary {\n      clip-path: none;\n    }\n  }\n\n  .index-sheet {\n    position: absolute;\n    top: 72px;\n    right: 250px;\n    left: 260px;\n    padding: 17px 25px 20px;\n    background: var(--ceramic);\n    border: 1px solid var(--indigo);\n    border-top: 0;\n  }\n\n  .index-sheet::before {\n    content: '';\n    position: absolute;\n    top: -8px;\n    right: 45px;\n    width: 0;\n    height: 0;\n    border-right: 8px solid transparent;\n    border-left: 8px solid transparent;\n    border-bottom: 8px solid var(--indigo);\n  }\n\n  .index-sheet::after {\n    content: '';\n    position: absolute;\n    top: -5px;\n    right: 46px;\n    width: 0;\n    height: 0;\n    border-right: 7px solid transparent;\n    border-left: 7px solid transparent;\n    border-bottom: 7px solid var(--ceramic);\n  }\n\n  .index-sheet__list {\n    margin: 0;\n    padding: 0;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    list-style: none;\n  }\n\n  .index-sheet__item {\n    border-inline-start: 1px solid var(--rule);\n  }\n\n  .index-sheet__item:first-child {\n    border-inline-start: 0;\n  }\n\n  .index-sheet__link {\n    min-height: 42px;\n    padding: 0 17px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    color: var(--indigo);\n    font-size: 13px;\n    font-weight: 400;\n    text-decoration: none;\n  }\n\n  .index-sheet__link:hover,\n  .index-sheet__link:focus-visible {\n    color: var(--crimson);\n    background: #E5EAE5;\n  }\n\n  .index-sheet__arrow {\n    width: 16px;\n    height: 16px;\n    font-size: 16px;\n    line-height: 16px;\n    flex: 0 0 16px;\n  }\n\n  .mobile-menu-toggle,\n  .mobile-index {\n    display: none;\n  }\n\n  @media (max-width: 1100px) and (min-width: 961px) {\n    .header-preview {\n      padding-inline: 24px;\n    }\n\n    .site-header {\n      grid-template-columns: 215px minmax(0, 1fr) 235px;\n    }\n\n    .index-sheet {\n      right: 215px;\n      left: 235px;\n    }\n\n    .header-actions {\n      gap: 11px;\n      padding-inline: 12px;\n    }\n\n    .header-action--primary {\n      padding-inline: 17px 25px;\n    }\n  }\n\n  @media (max-width: 960px) {\n    .header-preview {\n      min-height: 420px;\n      padding: 24px 16px 72px;\n    }\n\n    .header-preview__caption {\n      margin-bottom: 9px;\n    }\n\n    .site-header {\n      display: block;\n      min-height: 60px;\n      border-inline: 1px solid var(--rule);\n      border-bottom-width: 3px;\n    }\n\n    .brand-lockup {\n      min-height: 60px;\n      padding: 0 17px;\n      border-left: 0;\n    }\n\n    .brand-lockup__diamond {\n      width: 25px;\n      height: 25px;\n    }\n\n    .brand-lockup__signature {\n      height: 21px;\n    }\n\n    .brand-lockup__name {\n      font-size: 19px;\n    }\n\n    .desktop-nav,\n    .header-actions,\n    .index-sheet {\n      display: none;\n    }\n\n    .mobile-menu-toggle {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 60px;\n      height: 60px;\n      padding: 0;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      color: var(--indigo);\n      background: transparent;\n      border: 0;\n      border-right: 1px solid var(--rule);\n      cursor: pointer;\n    }\n\n    .mobile-menu-toggle__icon {\n      width: 20px;\n      height: 20px;\n      font-size: 20px;\n      line-height: 20px;\n    }\n\n    .mobile-index {\n      position: absolute;\n      z-index: 30;\n      top: 60px;\n      right: -1px;\n      left: -1px;\n      display: block;\n      background: var(--ceramic);\n      border: 1px solid var(--indigo);\n      border-top: 0;\n    }\n\n    .mobile-index__list {\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .mobile-index__row {\n      min-height: 60px;\n      display: flex;\n      align-items: stretch;\n      border-top: 1px solid var(--rule);\n    }\n\n    .mobile-index__row:first-child {\n      border-top: 0;\n    }\n\n    .mobile-index__link,\n    .mobile-index__trigger {\n      width: 100%;\n      min-height: 60px;\n      padding: 0 18px;\n      display: flex;\n      align-items: center;\n      gap: 15px;\n      color: var(--indigo);\n      background: transparent;\n      border: 0;\n      font: inherit;\n      font-size: 15px;\n      font-weight: 500;\n      line-height: 1.25;\n      text-align: right;\n      text-decoration: none;\n      cursor: pointer;\n    }\n\n    .mobile-index__number {\n      width: 28px;\n      direction: ltr;\n      color: var(--crimson);\n      font-size: 11px;\n      font-variant-numeric: tabular-nums;\n      font-weight: 500;\n      flex: 0 0 28px;\n    }\n\n    .mobile-index__label {\n      flex: 1 1 auto;\n    }\n\n    .mobile-index__chevron {\n      width: 18px;\n      height: 18px;\n      color: var(--indigo);\n      font-size: 18px;\n      line-height: 18px;\n      flex: 0 0 18px;\n      transition: transform 140ms ease;\n    }\n\n    .mobile-index__trigger[aria-expanded='true'] .mobile-index__chevron {\n      transform: rotate(-90deg);\n    }\n\n    .mobile-index__row--active {\n      background: var(--indigo);\n    }\n\n    .mobile-index__row--active .mobile-index__trigger {\n      color: var(--ceramic);\n    }\n\n    .mobile-index__row--active .mobile-index__chevron {\n      color: var(--ceramic);\n    }\n\n    .mobile-index__sublinks {\n      margin: 0;\n      padding: 0 18px 0 0;\n      list-style: none;\n      border-top: