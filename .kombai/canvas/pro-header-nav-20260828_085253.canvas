      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.network-demo {\n  --petrol: #0E1A20;\n  --raised: #15272F;\n  --rule: #34505A;\n  --ink: #F1F5F2;\n  --muted: #9BB0B7;\n  --signal: #FF6842;\n  --signal-pressed: #D95336;\n  box-sizing: border-box;\n  min-height: 560px;\n  margin: 0;\n  padding: 42px 28px 86px;\n  background: var(--petrol);\n  color: var(--ink);\n  font-family: 'Noto Kufi Arabic', sans-serif;\n  direction: rtl;\n  text-align: right;\n}\n\n.network-demo *,\n.network-demo *::before,\n.network-demo *::after {\n  box-sizing: border-box;\n}\n\n.network-demo button,\n.network-demo a {\n  font: inherit;\n}\n\n.network-demo a {\n  color: inherit;\n  text-decoration: none;\n}\n\n.network-demo button {\n  border: 0;\n  cursor: pointer;\n}\n\n.header-frame {\n  width: min(1240px, 100%);\n  margin: 0 auto;\n  border: 1px solid var(--rule);\n  background: var(--raised);\n}\n\n.desktop-header {\n  display: grid;\n  grid-template-columns: 210px minmax(480px, 1fr) 270px;\n  min-height: 68px;\n  direction: rtl;\n}\n\n.grid-cell {\n  min-width: 0;\n  min-height: 68px;\n  display: flex;\n  align-items: center;\n}\n\n.brand-cell {\n  padding: 0 22px;\n  border-inline-start: 1px solid var(--rule);\n}\n\n.brand-lockup {\n  display: inline-flex;\n  align-items: center;\n  gap: 11px;\n  min-height: 44px;\n  color: var(--ink);\n  font-size: 19px;\n  font-weight: 600;\n  letter-spacing: -.04em;\n  white-space: nowrap;\n}\n\n.brand-mark {\n  width: 32px;\n  height: 32px;\n  flex: 0 0 32px;\n  color: var(--ink);\n}\n\n.brand-mark .signal-cell {\n  fill: var(--signal);\n  stroke: var(--signal);\n}\n\n.brand-mark .grid-cell-mark {\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n}\n\n.nav-cell {\n  padding: 0 12px;\n  border-inline-start: 1px solid var(--rule);\n}\n\n.desktop-nav,\n.desktop-nav-list {\n  width: 100%;\n  height: 68px;\n}\n\n.desktop-nav-list {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.nav-item {\n  position: relative;\n  display: flex;\n  min-width: 0;\n  border-inline-start: 1px solid rgba(52, 80, 90, .7);\n}\n\n.nav-item:first-child {\n  border-inline-start: 0;\n}\n\n.nav-link,\n.nav-trigger {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  width: 100%;\n  min-height: 68px;\n  padding: 0 18px;\n  background: transparent;\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 400;\n  white-space: nowrap;\n  transition: color 140ms ease, background-color 140ms ease;\n}\n\n.nav-link:hover,\n.nav-link:focus-visible,\n.nav-trigger:hover,\n.nav-trigger:focus-visible {\n  color: var(--ink);\n  background: rgba(241, 245, 242, .035);\n}\n\n.nav-link:focus-visible,\n.nav-trigger:focus-visible,\n.brand-lockup:focus-visible,\n.bracket-link:focus-visible,\n.cut-corner-button:focus-visible,\n.mobile-toggle:focus-visible,\n.mobile-row:focus-visible,\n.mobile-link:focus-visible {\n  outline: 2px solid var(--signal);\n  outline-offset: -3px;\n}\n\n.nav-trigger .icon {\n  display: inline-block;\n  width: 15px;\n  height: 15px;\n  color: currentColor;\n  font-size: 15px;\n  line-height: 15px;\n  transition: transform 140ms ease;\n}\n\n.nav-trigger[aria-expanded='true'] {\n  color: var(--ink);\n  background: rgba(241, 245, 242, .035);\n}\n\n.nav-trigger[aria-expanded='true'] .icon {\n  transform: rotate(180deg);\n}\n\n.nav-trigger[aria-current='page']::after,\n.nav-trigger[aria-expanded='true']::after,\n.nav-link[aria-current='page']::after {\n  position: absolute;\n  right: 18px;\n  bottom: 0;\n  width: 24px;\n  height: 3px;\n  background: var(--signal);\n  content: '';\n}\n\n.action-cell {\n  justify-content: flex-start;\n  gap: 18px;\n  padding: 0 18px 0 22px;\n}\n\n.bracket-link {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n  padding: 0 10px;\n  color: var(--ink);\n  font-size: 12px;\n  font-weight: 400;\n  white-space: nowrap;\n}\n\n.bracket-link::before,\n.bracket-link::after {\n  position: absolute;\n  top: 11px;\n  bottom: 11px;\n  width: 5px;\n  content: '';\n}\n\n.bracket-link::before {\n  right: 0;\n  border-right: 1px solid var(--muted);\n  border-top: 1px solid var(--muted);\n  border-bottom: 1px solid var(--muted);\n}\n\n.bracket-link::after {\n  left: 0;\n  border-left: 1px solid var(--muted);\n  border-top: 1px solid var(--muted);\n  border-bottom: 1px solid var(--muted);\n}\n\n.bracket-link:hover,\n.bracket-link:focus-visible {\n  color: var(--signal);\n}\n\n.bracket-link:hover::before,\n.bracket-link:hover::after,\n.bracket-link:focus-visible::before,\n.bracket-link:focus-visible::after {\n  border-color: var(--signal);\n}\n\n.cut-corner-button {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 138px;\n  min-height: 44px;\n  padding: 0 16px;\n  background: var(--signal);\n  color: var(--petrol);\n  font-size: 12px;\n  font-weight: 600;\n  clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);\n  transition: background-color 140ms ease, color 140ms ease;\n}\n\n.cut-corner-button:hover {\n  background: var(--signal-pressed);\n}\n\n.cut-corner-button:active {\n  background: #C84931;\n}\n\n@supports not (clip-path: polygon(0 0)) {\n  .cut-corner-button {\n    border-radius: 0;\n  }\n}\n\n.mega-panel {\n  display: grid;\n  grid-template-columns: 210px minmax(480px, 1fr) 270px;\n  min-height: 112px;\n  border-top: 2px solid var(--signal);\n  background: var(--raised);\n  direction: rtl;\n}\n\n.mega-panel[hidden] {\n  display: none;\n}\n\n.panel-spacer {\n  border-inline-start: 1px solid var(--rule);\n}\n\n.panel-content {\n  grid-column: 2;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  align-items: stretch;\n  border-inline-start: 1px solid var(--rule);\n}\n\n.panel-link {\n  display: flex;\n  align-items: center;\n  min-height: 108px;\n  padding: 0 22px;\n  border-inline-start: 1px solid rgba(52, 80, 90, .72);\n  color: var(--ink);\n  font-size: 13px;\n  transition: color 140ms ease, background-color 140ms ease;\n}\n\n.panel-link:first-child {\n  border-inline-start: 0;\n}\n\n.panel-link:hover,\n.panel-link:focus-visible {\n  background: rgba(255, 104, 66, .08);\n  color: var(--signal);\n}\n\n.network-header-mobile,\n.mobile-menu {\n  display: none;\n}\n\n@media (max-width: 1040px) and (min-width: 861px) {\n  .desktop-header,\n  .mega-panel {\n    grid-template-columns: 180px minmax(430px, 1fr) 230px;\n  }\n\n  .nav-link,\n  .nav-trigger {\n    padding-inline: 10px;\n    font-size: 12px;\n  }\n\n  .action-cell {\n    gap: 8px;\n    padding-inline: 12px;\n  }\n\n  .cut-corner-button {\n    min-width: 124px;\n    padding-inline: 10px;\n  }\n}\n\n@media (max-width: 860px) {\n  .network-demo {\n    min-height: 680px;\n    padding: 20px 14px 60px;\n  }\n\n  .header-frame {\n    border: 1px solid var(--rule);\n  }\n\n  .desktop-header {\n    display: none;\n  }\n\n  .network-header-mobile {\n    display: flex;\n    min-height: 60px;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 14px 0 10px;\n    background: var(--raised);\n  }\n\n  .network-header-mobile .brand-lockup {\n    font-size: 18px;\n  }\n\n  .mobile-toggle {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-width: 112px;\n    min-height: 44px;\n    padding: 0 10px;\n    border: 1px solid var(--rule);\n    background: transparent;\n    color: var(--ink);\n    font-size: 11px;\n  }\n\n  .mobile-toggle .icon {\n    display: inline-block;\n    width: 18px;\n    height: 18px;\n    color: var(--signal);\n    font-size: 18px;\n    line-height: 18px;\n  }\n\n  .mobile-menu {\n    display: block;\n    border-top: 2px solid var(--signal);\n    background: var(--petrol);\n  }\n\n  .mobile-menu[hidden] {\n    display: none;\n  }\n\n  .mobile-row,\n  .mobile-link {\n    display: flex;\n    width: 100%;\n    min-height: 58px;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 18px;\n    border-bottom: 1px solid var(--rule);\n    background: transparent;\n    color: var(--ink);\n    font-size: 13px;\n    text-align: right;\n  }\n\n  .mobile-row:hover,\n  .mobile-row:focus-visible,\n  .mobile-link:hover,\n  .mobile-link:focus-visible {\n    background: rgba(255, 104, 66, .08);\n  }\n\n  .mobile-row .row-label {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .mobile-row .row-number {\n    color: var(--signal);\n    font-size: 10px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .mobile-row .icon {\n    display: inline-block;\n    width: 16px;\n    height: 16px;\n    color: var(--signal);\n    font-size: 16px;\n    line-height: 16px;\n  }\n\n  .mobile-submenu {\n    display: grid;\n    grid-template-rows: 1fr;\n    overflow: hidden;\n    background: var(--raised);\n    transition: grid-template-rows 140ms ease;\n  }\n\n  .mobile-submenu[hidden] {\n    display: grid;\n    grid-template-rows: 0fr;\n  }\n\n  .mobile-submenu-inner {\n    min-height: 0;\n    overflow: hidden;\n  }\n\n  .mobile-sub-link {\n    display: flex;\n    min-height: 46px;\n    align-items: center;\n    padding: 0 54px 0 18px;\n    border-bottom: 1px solid rgba(52, 80, 90, .75);\n    color: var(--muted);\n    font-size: 12px;\n  }\n\n  .mobile-sub-link:hover,\n  .mobile-sub-link:focus-visible {\n    color: var(--signal);\n  }\n\n  .mobile-actions {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding: 22px 18px 24px;\n    background: var(--petrol);\n  }\n\n  .mobile-login {\n    align-self: flex-start;\n    min-height: 42px;\n    color: var(--ink);\n    font-size: 12px;\n    text-decoration: underline;\n    text-decoration-color: transparent;\n    text-underline-offset: 5px;\n  }\n\n  .mobile-login:hover,\n  .mobile-login:focus-visible {\n    color: var(--signal);\n    text-decoration-color: currentColor;\n  }\n\n  .mobile-actions .cut-corner-button {\n    width: 100%;\n    min-height: 48px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .network-demo *,\n  .network-demo *::before,\n  .network-demo *::after {\n    transition: none !important;\n  }\n}\n</style>\n<div class=\"network-demo\" data-kid=\"1\" data-name=\"network component container\" data-network-header=\"\" dir=\"rtl\" lang=\"ar\">\n    <div class=\"header-frame\" data-kid=\"1-1\" data-name=\"header frame container\">\n        <header aria-label=\"رأس الموقع\" class=\"desktop-header\" data-kid=\"1-1-1\" data-name=\"desktop navigation header\">\n            <div class=\"grid-cell brand-cell\" data-kid=\"1-1-1-1\" data-name=\"brand identity cell\">\n                <a aria-label=\"نَسَق — الصفحة الرئيسية\" class=\"brand-lockup\" data-kid=\"1-1-1-1-1\" data-name=\"brand link\" href=\"#\">\n                    <svg aria-label=\"علامة نَسَق\" class=\"brand-mark\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand mark icon\" role=\"img\" viewbox=\"0 0 36 36\">\n                        <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"2\" y=\"2\">\n                        </rect>\n                        <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"14\" y=\"2\">\n                        </rect>\n                        <rect class=\"signal-cell\" height=\"8\" width=\"8\" x=\"26\" y=\"2\">\n                        </rect>\n                        <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"2\" y=\"14\">\n                        </rect>\n                        <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"14\" y=\"14\">\n                        </rect>\n                        <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"26\" y=\"14\">\n                        </rect>\n                        <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"2\" y=\"26\">\n                        </rect>\n                        <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"14\" y=\"26\">\n                        </rect>\n                    </svg>\n                    <span data-kid=\"1-1-1-1-1-2\" data-name=\"brand name text\">\n                        نَسَق\n                    </span>\n                </a>\n            </div>\n            <div class=\"grid-cell nav-cell\" data-kid=\"1-1-1-2\" data-name=\"desktop navigation cell\">\n                <nav aria-label=\"التنقل الرئيسي\" class=\"desktop-nav\" data-kid=\"1-1-1-2-1\" data-name=\"desktop navigation\">\n                    <ul class=\"desktop-nav-list\" data-kid=\"1-1-1-2-1-1\" data-name=\"desktop navigation list\">\n                        <li class=\"nav-item\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"navigation item\">\n                            <button aria-controls=\"menu-product\" aria-current=\"page\" aria-expanded=\"true\" class=\"nav-trigger\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1-1-1\" data-name=\"navigation dropdown trigger\" data-reason=\"aria-expanded attribute updated by script\" id=\"nav-product\" type=\"button\">\n                                <span data-kid=\"1-1-1-2-1-1-1-1-1\" data-name=\"navigation trigger text\">\n                                    المنتج\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down icon\" data-kid=\"1-1-1-2-1-1-1-1-2\" data-name=\"dropdown arrow icon\">\n                                </i>\n                            </button>\n                        </li>\n                        <li class=\"nav-item\" data-kid=\"1-1-1-2-1-1-2\" data-name=\"navigation item\">\n                            <button aria-controls=\"menu-solutions\" aria-expanded=\"false\" class=\"nav-trigger\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1-2-1\" data-name=\"navigation dropdown trigger\" data-reason=\"aria-expanded attribute updated by script\" id=\"nav-solutions\" type=\"button\">\n                                <span data-kid=\"1-1-1-2-1-1-2-1-1\" data-name=\"navigation trigger text\">\n                                    الحلول\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down icon\" data-kid=\"1-1-1-2-1-1-2-1-2\" data-name=\"dropdown arrow icon\">\n                                </i>\n                            </button>\n                        </li>\n                        <li class=\"nav-item\" data-kid=\"1-1-1-2-1-1-3\" data-name=\"navigation item\">\n                            <a class=\"nav-link\" data-kid=\"1-1-1-2-1-1-3-1\" data-name=\"navigation link\" href=\"#pricing\">\n                                الأسعار\n                            </a>\n                        </li>\n                        <li class=\"nav-item\" data-kid=\"1-1-1-2-1-1-4\" data-name=\"navigation item\">\n                            <button aria-controls=\"menu-resources\" aria-expanded=\"false\" class=\"nav-trigger\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1-4-1\" data-name=\"navigation dropdown trigger\" data-reason=\"aria-expanded attribute updated by script\" id=\"nav-resources\" type=\"button\">\n                                <span data-kid=\"1-1-1-2-1-1-4-1-1\" data-name=\"navigation trigger text\">\n                                    الموارد\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down icon\" data-kid=\"1-1-1-2-1-1-4-1-2\" data-name=\"dropdown arrow icon\">\n                                </i>\n                            </button>\n                        </li>\n                    </ul>\n                </nav>\n            </div>\n            <div class=\"grid-cell action-cell\" data-kid=\"1-1-1-3\" data-name=\"header action cell\">\n                <a class=\"bracket-link\" data-kid=\"1-1-1-3-1\" data-name=\"login bracket link\" href=\"#login\">\n                    تسجيل الدخول\n                </a>\n                <a class=\"cut-corner-button\" data-kid=\"1-1-1-3-2\" data-name=\"workspace call-to-action button\" href=\"#workspace\">\n                    أنشئ مساحة عمل\n                </a>\n            </div>\n        </header>\n        <div class=\"network-header-mobile\" data-kid=\"1-1-2\" data-name=\"mobile header container\">\n            <a aria-label=\"نَسَق — الصفحة الرئيسية\" class=\"brand-lockup\" data-kid=\"1-1-2-1\" data-name=\"mobile brand link\" href=\"#\">\n                <svg aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-2-1-1\" data-name=\"mobile brand mark icon\" viewbox=\"0 0 36 36\">\n                    <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"2\" y=\"2\">\n                    </rect>\n                    <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"14\" y=\"2\">\n                    </rect>\n                    <rect class=\"signal-cell\" height=\"8\" width=\"8\" x=\"26\" y=\"2\">\n                    </rect>\n                    <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"2\" y=\"14\">\n                    </rect>\n                    <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"14\" y=\"14\">\n                    </rect>\n                    <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"26\" y=\"14\">\n                    </rect>\n                    <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"2\" y=\"26\">\n                    </rect>\n                    <rect class=\"grid-cell-mark\" height=\"8\" width=\"8\" x=\"14\" y=\"26\">\n                    </rect>\n                </svg>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"mobile brand name text\">\n                    نَسَق\n                </span>\n            </a>\n            <button aria-controls=\"mobile-menu\" aria-expanded=\"false\" class=\"mobile-toggle\" data-dynamic=\"true\" data-kid=\"1-1-2-2\" data-name=\"mobile menu toggle button\" data-reason=\"aria-expanded attribute updated by script\" id=\"mobile-toggle\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-menu-2 icon\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1\" data-name=\"toggle icon\" data-reason=\"class toggled by script between menu and x\">\n                </i>\n                <span class=\"toggle-label\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2\" data-name=\"toggle label text\" data-reason=\"text updated by script between open and close\">\n                    فتح القائمة\n                </span>\n            </button>\n        </div>\n        <section aria-labelledby=\"nav-product\" class=\"mega-panel\" data-desktop-panel=\"\" data-dynamic=\"true\" data-kid=\"1-1-3\" data-name=\"desktop product menu panel\" data-reason=\"hidden attribute toggled by script\" id=\"menu-product\">\n            <div aria-hidden=\"true\" class=\"panel-spacer\" data-kid=\"1-1-3-1\" data-name=\"panel spacer\">\n            </div>\n            <div class=\"panel-content\" data-kid=\"1-1-3-2\" data-name=\"panel content wrapper\">\n                <a class=\"panel-link\" data-kid=\"1-1-3-2-1\" data-name=\"panel link\" href=\"#overview\">\n                    نظرة عامة\n                </a>\n                <a class=\"panel-link\" data-kid=\"1-1-3-2-2\" data-name=\"panel link\" href=\"#automation\">\n                    الأتمتة\n                </a>\n                <a class=\"panel-link\" data-kid=\"1-1-3-2-3\" data-name=\"panel link\" href=\"#integrations\">\n                    التكاملات\n                </a>\n            </div>\n            <div aria-hidden=\"true\" class=\"panel-spacer\" data-kid=\"1-1-3-3\" data-name=\"panel spacer\">\n            </div>\n        </section>\n        <section aria-labelledby=\"nav-solutions\" class=\"mega-panel\" data-desktop-panel=\"\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"desktop solutions menu panel\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"menu-solutions\">\n            <div aria-hidden=\"true\" class=\"panel-spacer\" data-kid=\"1-1-4-1\" data-name=\"panel spacer\">\n            </div>\n            <div class=\"panel-content\" data-kid=\"1-1-4-2\" data-name=\"panel content wrapper\">\n                <a class=\"panel-link\" data-kid=\"1-1-4-2-1\" data-name=\"panel link\" href=\"#product-teams\">\n                    فرق المنتج\n                </a>\n                <a class=\"panel-link\" data-kid=\"1-1-4-2-2\" data-name=\"panel link\" href=\"#operations\">\n                    فرق العمليات\n                </a>\n                <a class=\"panel-link\" data-kid=\"1-1-4-2-3\" data-name=\"panel link\" href=\"#support\">\n                    دعم العملاء\n                </a>\n            </div>\n            <div aria-hidden=\"true\" class=\"panel-spacer\" data-kid=\"1-1-4-3\" data-name=\"panel spacer\">\n            </div>\n        </section>\n        <section aria-labelledby=\"nav-resources\" class=\"mega-panel\" data-desktop-panel=\"\" data-dynamic=\"true\" data-kid=\"1-1-5\" data-name=\"desktop resources menu panel\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"menu-resources\">\n            <div aria-hidden=\"true\" class=\"panel-spacer\" data-kid=\"1-1-5-1\" data-name=\"panel spacer\">\n            </div>\n            <div class=\"panel-content\" data-kid=\"1-1-5-2\" data-name=\"panel content wrapper\">\n                <a class=\"panel-link\" data-kid=\"1-1-5-2-1\" data-name=\"panel link\" href=\"#guide\">\n                    الدليل\n                </a>\n                <a class=\"panel-link\" data-kid=\"1-1-5-2-2\" data-name=\"panel link\" href=\"#help\">\n                    مركز المساعدة\n                </a>\n            </div>\n            <div aria-hidden=\"true\" class=\"panel-spacer\" data-kid=\"1-1-5-3\" data-name=\"panel spacer\">\n            </div>\n        </section>\n        <div aria-label=\"قائمة الهاتف\" class=\"mobile-menu\" data-dynamic=\"true\" data-kid=\"1-1-6\" data-name=\"mobile menu panel\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"mobile-menu\">\n            <button aria-controls=\"mobile-product\" aria-expanded=\"false\" class=\"mobile-row\" data-dynamic=\"true\" data-kid=\"1-1-6-1\" data-mobile-accordion=\"\" data-name=\"mobile accordion trigger\" data-reason=\"aria-expanded attribute updated by script\" type=\"button\">\n                <span class=\"row-label\" data-kid=\"1-1-6-1-1\" data-name=\"mobile trigger label container\">\n                    <span aria-hidden=\"true\" class=\"row-number\" data-kid=\"1-1-6-1-1-1\" data-name=\"mobile row number text\">\n                        01\n                    </span>\n                    <span data-kid=\"1-1-6-1-1-2\" data-name=\"mobile trigger label text\">\n                        المنتج\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-plus icon\" data-dynamic=\"true\" data-kid=\"1-1-6-1-2\" data-name=\"mobile accordion icon\" data-reason=\"class toggled by script between plus and minus\">\n                </i>\n            </button>\n            <div class=\"mobile-submenu\" data-dynamic=\"true\" data-kid=\"1-1-6-2\" data-name=\"mobile submenu panel\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"mobile-product\">\n                <div class=\"mobile-submenu-inner\" data-kid=\"1-1-6-2-1\" data-name=\"submenu inner container\">\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-2-1-1\" data-name=\"submenu link\" href=\"#overview\">\n                        نظرة عامة\n                    </a>\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-2-1-2\" data-name=\"submenu link\" href=\"#automation\">\n                        الأتمتة\n                    </a>\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-2-1-3\" data-name=\"submenu link\" href=\"#integrations\">\n                        التكاملات\n                    </a>\n                </div>\n            </div>\n            <button aria-controls=\"mobile-solutions\" aria-expanded=\"false\" class=\"mobile-row\" data-dynamic=\"true\" data-kid=\"1-1-6-3\" data-mobile-accordion=\"\" data-name=\"mobile accordion trigger\" data-reason=\"aria-expanded attribute updated by script\" type=\"button\">\n                <span class=\"row-label\" data-kid=\"1-1-6-3-1\" data-name=\"mobile trigger label container\">\n                    <span aria-hidden=\"true\" class=\"row-number\" data-kid=\"1-1-6-3-1-1\" data-name=\"mobile row number text\">\n                        02\n                    </span>\n                    <span data-kid=\"1-1-6-3-1-2\" data-name=\"mobile trigger label text\">\n                        الحلول\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-plus icon\" data-dynamic=\"true\" data-kid=\"1-1-6-3-2\" data-name=\"mobile accordion icon\" data-reason=\"class toggled by script between plus and minus\">\n                </i>\n            </button>\n            <div class=\"mobile-submenu\" data-dynamic=\"true\" data-kid=\"1-1-6-4\" data-name=\"mobile submenu panel\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"mobile-solutions\">\n                <div class=\"mobile-submenu-inner\" data-kid=\"1-1-6-4-1\" data-name=\"submenu inner container\">\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-4-1-1\" data-name=\"submenu link\" href=\"#product-teams\">\n                        فرق المنتج\n                    </a>\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-4-1-2\" data-name=\"submenu link\" href=\"#operations\">\n                        فرق العمليات\n                    </a>\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-4-1-3\" data-name=\"submenu link\" href=\"#support\">\n                        دعم العملاء\n                    </a>\n                </div>\n            </div>\n            <a class=\"mobile-link\" data-kid=\"1-1-6-5\" data-name=\"mobile link\" href=\"#pricing\">\n                <span class=\"row-label\" data-kid=\"1-1-6-5-1\" data-name=\"mobile trigger label container\">\n                    <span aria-hidden=\"true\" class=\"row-number\" data-kid=\"1-1-6-5-1-1\" data-name=\"mobile row number text\">\n                        03\n                    </span>\n                    <span data-kid=\"1-1-6-5-1-2\" data-name=\"mobile trigger label text\">\n                        الأسعار\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-left icon\" data-kid=\"1-1-6-5-2\" data-name=\"mobile icon\">\n                </i>\n            </a>\n            <button aria-controls=\"mobile-resources\" aria-expanded=\"false\" class=\"mobile-row\" data-dynamic=\"true\" data-kid=\"1-1-6-6\" data-mobile-accordion=\"\" data-name=\"mobile accordion trigger\" data-reason=\"aria-expanded attribute updated by script\" type=\"button\">\n                <span class=\"row-label\" data-kid=\"1-1-6-6-1\" data-name=\"mobile trigger label container\">\n                    <span aria-hidden=\"true\" class=\"row-number\" data-kid=\"1-1-6-6-1-1\" data-name=\"mobile row number text\">\n                        04\n                    </span>\n                    <span data-kid=\"1-1-6-6-1-2\" data-name=\"mobile trigger label text\">\n                        الموارد\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-plus icon\" data-dynamic=\"true\" data-kid=\"1-1-6-6-2\" data-name=\"mobile accordion icon\" data-reason=\"class toggled by script between plus and minus\">\n                </i>\n            </button>\n            <div class=\"mobile-submenu\" data-dynamic=\"true\" data-kid=\"1-1-6-7\" data-name=\"mobile submenu panel\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"mobile-resources\">\n                <div class=\"mobile-submenu-inner\" data-kid=\"1-1-6-7-1\" data-name=\"submenu inner container\">\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-7-1-1\" data-name=\"submenu link\" href=\"#guide\">\n                        الدليل\n                    </a>\n                    <a class=\"mobile-sub-link\" data-kid=\"1-1-6-7-1-2\" data-name=\"submenu link\" href=\"#help\">\n                        مركز المساعدة\n                    </a>\n                </div>\n            </div>\n            <div class=\"mobile-actions\" data-kid=\"1-1-6-8\" data-name=\"mobile action container\">\n                <a class=\"mobile-login\" data-kid=\"1-1-6-8-1\" data-name=\"mobile login link\" href=\"#login\">\n                    تسجيل الدخول\n                </a>\n                <a class=\"cut-corner-button\" data-kid=\"1-1-6-8-2\" data-name=\"mobile workspace call-to-action button\" href=\"#workspace\">\n                    أنشئ مساحة عمل\n                </a>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (() => {\n  const root = document.querySelector('[data-network-header]');\n  if (!root) return;\n\n  const desktopTriggers = Array.from(root.querySelectorAll('.nav-trigger[aria-controls]'));\n  const desktopPanels = Array.from(root.querySelectorAll('[data-desktop-panel]'));\n  const mobileToggle = root.querySelector('#mobile-toggle');\n  const mobileMenu = root.querySelector('#mobile-menu');\n  const toggleIcon = mobileToggle ? mobileToggle.querySelector('.icon') : null;\n  const toggleLabel = mobileToggle ? mobileToggle.querySelector('.toggle-label') : null;\n\n  const closeDesktopPanels = () => {\n    desktopPanels.forEach((panel) => {\n      panel.hidden = true;\n    });\n    desktopTriggers.forEach((trigger) => {\n      trigger.setAttribute('aria-expanded', 'false');\n    });\n  };\n\n  const openDesktopPanel = (trigger) => {\n    const targetId = trigger.getAttribute('aria-controls');\n    const target = root.querySelector('#' + targetId);\n    if (!target) return;\n    const wasOpen = trigger.getAttribute('aria-expanded') === 'true';\n    closeDesktopPanels();\n    if (!wasOpen) {\n      target.hidden = false;\n      trigger.setAttribute('aria-expanded', 'true');\n    }\n  };\n\n  desktopTriggers.forEach((trigger) => {\n    trigger.addEventListener('click', (event) => {\n      event.stopPropagation();\n      openDesktopPanel(trigger);\n    });\n  });\n\n  const setMobileState = (open) => {\n    if (!mobileToggle || !mobileMenu || !toggleIcon || !toggleLabel) return;\n    mobileToggle.setAttribute('aria-expanded', String(open));\n    mobileMenu.hidden = !open;\n    toggleIcon.classList.toggle('ti-menu-2', !open);\n    toggleIcon.classList.toggle('ti-x', open);\n    toggleLabel.textContent = open ? 'إغلاق القائمة' : 'فتح القائمة';\n    root.classList.toggle('is-mobile-open', open);\n  };\n\n  if (mobileToggle) {\n    mobileToggle.addEventListener('click', (event) => {\n      event.stopPropagation();\n      setMobileState(mobileToggle.getAttribute('aria-expanded') !== 'true');\n    });\n  }\n\n  root.querySelectorAll('[data-mobile-accordion]').forEach((row) => {\n    row.addEventListener('click', () => {\n      const target = root.querySelector('#' + row.getAttribute('aria-controls'));\n      const icon = row.querySelector('.icon');\n      if (!target || !icon) return;\n      const willOpen = row.getAttribute('aria-expanded') !== 'true';\n      row.setAttribute('aria-expanded', String(willOpen));\n      target.hidden = !willOpen;\n      icon.classList.toggle('ti-plus', !willOpen);\n      icon.classList.toggle('ti-minus', willOpen);\n    });\n  });\n\n  root.querySelectorAll('.mobile-menu a').forEach((link) => {\n    link.addEventListener('click', () => setMobileState(false));\n  });\n\n  document.addEventListener('click', (event) => {\n    if (!root.contains(event.target)) {\n      closeDesktopPanels();\n      setMobileState(false);\n    }\n  });\n\n  document.addEventListener('keydown', (event) => {\n    if (event.key !== 'Escape') return;\n    closeDesktopPanels();\n    setMobileState(false);\n    if (document.activeElement instanceof HTMLElement && root.contains(document.activeElement)) {\n      if (mobileToggle && window.matchMedia('(max-width: 860px)').matches) mobileToggle.focus();\n    }\n  });\n})();\n</script>\n",
      "comments": [],
      "created": "2026-08-28T08:57:39.424668+00:00",
