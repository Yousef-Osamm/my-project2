                           01\n                        </span>\n                        <span class=\"mobile-index__label\" data-kid=\"1-2-6-1-1-1-2\">\n                            المنتج\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-chevron-left mobile-index__chevron\" data-kid=\"1-2-6-1-1-1-3\" data-name=\"chevron icon\" style=\"width:18px;height:18px;font-size:18px;line-height:18px\">\n                        </i>\n                    </button>\n                </li>\n                <li data-dynamic=\"true\" data-kid=\"1-2-6-1-2\" data-name=\"mobile sublink container\" data-reason=\"hidden attribute toggled by script\">\n                    <ul class=\"mobile-index__sublinks\" data-kid=\"1-2-6-1-2-1\" data-name=\"mobile sublinks list\" id=\"mobile-product-sublinks\">\n                        <li data-kid=\"1-2-6-1-2-1-1\">\n                            <a class=\"mobile-index__sublink\" data-kid=\"1-2-6-1-2-1-1-1\" data-name=\"sublink\" href=\"#overview\">\n                                <span data-kid=\"1-2-6-1-2-1-1-1-1\">\n                                    نظرة عامة\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-left mobile-index__sublink-icon\" data-kid=\"1-2-6-1-2-1-1-1-2\" style=\"width:16px;height:16px;font-size:16px;line-height:16px\">\n                                </i>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-2-6-1-2-1-2\">\n                            <a class=\"mobile-index__sublink\" data-kid=\"1-2-6-1-2-1-2-1\" data-name=\"sublink\" href=\"#automation\">\n                                <span data-kid=\"1-2-6-1-2-1-2-1-1\">\n                                    الأتمتة\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-left mobile-index__sublink-icon\" data-kid=\"1-2-6-1-2-1-2-1-2\" style=\"width:16px;height:16px;font-size:16px;line-height:16px\">\n                                </i>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-2-6-1-2-1-3\">\n                            <a class=\"mobile-index__sublink\" data-kid=\"1-2-6-1-2-1-3-1\" data-name=\"sublink\" href=\"#integrations\">\n                                <span data-kid=\"1-2-6-1-2-1-3-1-1\">\n                                    التكاملات\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-left mobile-index__sublink-icon\" data-kid=\"1-2-6-1-2-1-3-1-2\" style=\"width:16px;height:16px;font-size:16px;line-height:16px\">\n                                </i>\n                            </a>\n                        </li>\n                    </ul>\n                </li>\n                <li class=\"mobile-index__row\" data-kid=\"1-2-6-1-3\" data-name=\"mobile menu row\">\n                    <a class=\"mobile-index__link\" data-kid=\"1-2-6-1-3-1\" data-name=\"mobile menu link\" href=\"#solutions\">\n                        <span aria-hidden=\"true\" class=\"mobile-index__number\" data-kid=\"1-2-6-1-3-1-1\" data-name=\"navigation number\">\n                            02\n                        </span>\n                        <span class=\"mobile-index__label\" data-kid=\"1-2-6-1-3-1-2\">\n                            الحلول\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-chevron-left mobile-index__chevron\" data-kid=\"1-2-6-1-3-1-3\" data-name=\"chevron icon\" style=\"width:18px;height:18px;font-size:18px;line-height:18px\">\n                        </i>\n                    </a>\n                </li>\n                <li class=\"mobile-index__row\" data-kid=\"1-2-6-1-4\" data-name=\"mobile menu row\">\n                    <a class=\"mobile-index__link\" data-kid=\"1-2-6-1-4-1\" data-name=\"mobile menu link\" href=\"#pricing\">\n                        <span aria-hidden=\"true\" class=\"mobile-index__number\" data-kid=\"1-2-6-1-4-1-1\" data-name=\"navigation number\">\n                            03\n                        </span>\n                        <span class=\"mobile-index__label\" data-kid=\"1-2-6-1-4-1-2\">\n                            الأسعار\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-chevron-left mobile-index__chevron\" data-kid=\"1-2-6-1-4-1-3\" data-name=\"chevron icon\" style=\"width:18px;height:18px;font-size:18px;line-height:18px\">\n                        </i>\n                    </a>\n                </li>\n                <li class=\"mobile-index__row\" data-kid=\"1-2-6-1-5\" data-name=\"mobile menu row\">\n                    <a class=\"mobile-index__link\" data-kid=\"1-2-6-1-5-1\" data-name=\"mobile menu link\" href=\"#resources\">\n                        <span aria-hidden=\"true\" class=\"mobile-index__number\" data-kid=\"1-2-6-1-5-1-1\" data-name=\"navigation number\">\n                            04\n                        </span>\n                        <span class=\"mobile-index__label\" data-kid=\"1-2-6-1-5-1-2\">\n                            الموارد\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-chevron-left mobile-index__chevron\" data-kid=\"1-2-6-1-5-1-3\" data-name=\"chevron icon\" style=\"width:18px;height:18px;font-size:18px;line-height:18px\">\n                        </i>\n                    </a>\n                </li>\n            </ul>\n            <div class=\"mobile-index__actions\" data-kid=\"1-2-6-2\" data-name=\"mobile actions container\">\n                <a class=\"mobile-index__login\" data-kid=\"1-2-6-2-1\" data-name=\"mobile login link\" href=\"#login\">\n                    تسجيل الدخول\n                </a>\n                <a class=\"mobile-index__cta\" data-kid=\"1-2-6-2-2\" data-name=\"mobile primary call-to-action button\" href=\"#workspace\">\n                    أنشئ مساحة عمل\n                </a>\n            </div>\n        </div>\n    </header>\n</div>\n<script>\n    (() => {\n    const siteHeader = document.getElementById('site-header');\n    const productTrigger = document.getElementById('product-trigger');\n    const productSheet = document.getElementById('product-sheet');\n    const mobileToggle = document.getElementById('mobile-menu-toggle');\n    const mobileIndex = document.getElementById('mobile-index');\n    const mobileProductTrigger = document.getElementById('mobile-product-trigger');\n    const mobileProductSublinks = document.getElementById('mobile-product-sublinks');\n\n    const setDesktopSheet = (isOpen) => {\n      productTrigger.setAttribute('aria-expanded', String(isOpen));\n      productSheet.hidden = !isOpen;\n    };\n\n    const setMobileProduct = (isOpen) => {\n      mobileProductTrigger.setAttribute('aria-expanded', String(isOpen));\n      mobileProductSublinks.hidden = !isOpen;\n    };\n\n    const setMobileIndex = (isOpen) => {\n      mobileToggle.setAttribute('aria-expanded', String(isOpen));\n      mobileToggle.setAttribute('aria-label', isOpen ? 'إغلاق القائمة' : 'فتح القائمة');\n      mobileIndex.hidden = !isOpen;\n      document.documentElement.style.overflow = isOpen ? 'hidden' : '';\n      if (!isOpen) setMobileProduct(true);\n    };\n\n    productTrigger.addEventListener('click', () => {\n      setDesktopSheet(productSheet.hidden);\n    });\n\n    mobileToggle.addEventListener('click', () => {\n      setMobileIndex(mobileIndex.hidden);\n    });\n\n    mobileProductTrigger.addEventListener('click', () => {\n      setMobileProduct(mobileProductSublinks.hidden);\n    });\n\n    mobileIndex.querySelectorAll('a').forEach((link) => {\n      link.addEventListener('click', () => setMobileIndex(false));\n    });\n\n    document.addEventListener('click', (event) => {\n      if (!siteHeader.contains(event.target)) {\n        setDesktopSheet(false);\n        setMobileIndex(false);\n      }\n    });\n\n    document.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape') {\n        setDesktopSheet(false);\n        setMobileIndex(false);\n        productTrigger.focus();\n      }\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-28T08:57:56.218589+00:00",
      "modified": "2026-08-28T08:58:56.071758+00:00",
